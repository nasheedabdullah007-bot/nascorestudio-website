# ==============================================================================
# NASCORE STUDIO — OFFICIAL CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. YOUTUBE DATA API V3 (FREE TIER)
# ------------------------------------------------------------------------------
# Get your API key:
# 1. Go to https://console.cloud.google.com/
# 2. Create/select a project, enable "YouTube Data API v3"
# 3. Under Credentials, create an API Key
# 4. (Recommended) Restrict the key to "Websites" (e.g. your custom domain or https://yourusername.github.io/*)
VITE_YOUTUBE_API_KEY="YOUR_YOUTUBE_DATA_API_KEY_HERE"

# Your YouTube Channel ID (starts with UC...) or channel handle (e.g. @nascorestudio)
# You can find your Channel ID at: https://www.youtube.com/account_advanced
VITE_YOUTUBE_CHANNEL_ID="UC_x5XG1OV2P6uZZ5FSM9Ttw"

# ------------------------------------------------------------------------------
# 2. GITHUB-POWERED NOTICE PUBLISHING
# ------------------------------------------------------------------------------
# Set your GitHub repository owner and name so notices fetch directly from GitHub Raw
VITE_GITHUB_REPO_OWNER="nasheedabdullah007-bot"
VITE_GITHUB_REPO_NAME="nascorestudio-website"

# ------------------------------------------------------------------------------
# 3. AI STUDIO SYSTEM INJECTIONS
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
